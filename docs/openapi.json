                  "$ref": "#/components/schemas/DatasetProfileOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/runs": {
      "post": {
        "tags": [
          "runs"
        ],
        "summary": "Create Run",
        "description": "Queue a network build. Poll GET /runs/{id} until status is succeeded/failed.",
        "operationId": "create_run_api_runs_post",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/AuthorRunCreate"
                  },
                  {
                    "$ref": "#/components/schemas/InstitutionKeywordRunCreate"
                  }
                ],
                "discriminator": {
                  "propertyName": "relation",
                  "mapping": {
                    "author": "#/components/schemas/AuthorRunCreate",
                    "institution_keywords": "#/components/schemas/InstitutionKeywordRunCreate"
                  }
                },
                "title": "Body"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "runs"
        ],
        "summary": "List Runs",
        "operationId": "list_runs_api_runs_get",
        "parameters": [
          {
            "name": "dataset_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Dataset Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/RunOut"
                  },
                  "title": "Response List Runs Api Runs Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/runs/{run_id}": {
      "get": {
        "tags": [
          "runs"
        ],
        "summary": "Get Run",
        "operationId": "get_run_api_runs__run_id__get",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Run Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "runs"
        ],
        "summary": "Delete Run",
        "operationId": "delete_run_api_runs__run_id__delete",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Run Id"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/runs/{run_id}/network": {
      "get": {
        "tags": [
          "runs"
        ],
        "summary": "Get Network",
        "operationId": "get_network_api_runs__run_id__network_get",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Run Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Network JSON (see docs/network.schema.json)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Network"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/runs/{run_id}/export": {
      "get": {
        "tags": [
          "runs"
        ],
        "summary": "Export Network",
        "operationId": "export_network_api_runs__run_id__export_get",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Run Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AuthorParams": {
        "properties": {
          "max_authors": {
            "type": "integer",
            "maximum": 200.0,
            "minimum": 2.0,
            "title": "Max Authors",
            "description": "Drop articles with more authors",
            "default": 15
          },
          "max_team_categories": {
            "type": "integer",
            "maximum": 50.0,
            "minimum": 1.0,
            "title": "Max Team Categories",
            "default": 22
          },
          "min_team_size": {
            "type": "integer",
            "maximum": 1000.0,
            "minimum": 1.0,
            "title": "Min Team Size",
            "default": 2
          },
          "top_n": {
            "type": "integer",
            "maximum": 2000.0,
            "minimum": 10.0,
            "title": "Top N",
            "default": 700
          },
          "team_attribute": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "country",
                  "institution",
                  "institution_department"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Team Attribute",
            "default": "country"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "AuthorParams"
      },
      "AuthorRunCreate": {
        "properties": {
          "dataset_id": {
            "type": "integer",
            "title": "Dataset Id"
          },
          "relation": {
            "type": "string",
            "const": "author",
            "title": "Relation"
          },
          "params": {
            "$ref": "#/components/schemas/AuthorParams",
            "default": {
              "max_authors": 15,
              "max_team_categories": 22,
              "min_team_size": 2,
              "top_n": 700,
              "team_attribute": "country"
            }
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "dataset_id",
          "relation"
        ],
        "title": "AuthorRunCreate"
      },
      "Body_create_dataset_api_datasets_post": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Name"
          },
          "files": {
            "items": {
              "type": "string",
              "contentMediaType": "application/octet-stream"
            },
            "type": "array",
            "title": "Files",
            "description": "WoS .xls exports"
          }
        },
        "type": "object",
        "required": [
          "name",
          "files"
        ],
        "title": "Body_create_dataset_api_datasets_post"
      },
      "Credentials": {
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 256,
            "minLength": 1,
            "title": "Password"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "Credentials"
      },
      "DatasetFileOut": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "original_name": {
            "type": "string",
            "title": "Original Name"
          },
          "size_bytes": {
            "type": "integer",
            "title": "Size Bytes"
          },
          "sha256": {
            "type": "string",
            "title": "Sha256"
          }
        },
        "type": "object",
        "required": [
          "id",
          "original_name",
          "size_bytes",
          "sha256"
        ],
        "title": "DatasetFileOut"
      },
      "DatasetOut": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "profile_status": {
            "type": "string",
            "enum": [
              "pending",
              "ready",
              "failed"
            ],
            "title": "Profile Status"
          },
          "profile_error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Profile Error"
          },
          "files": {
            "items": {
              "$ref": "#/components/schemas/DatasetFileOut"
            },
            "type": "array",
            "title": "Files"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "created_at",
          "profile_status",
          "profile_error",
          "files"
        ],
        "title": "DatasetOut"
      },
      "DatasetProfileOut": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "ready",
              "failed"
            ],
            "title": "Status"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "profile": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Profile"
          }
        },
        "type": "object",
        "required": [
          "status",
          "error",
          "profile"
        ],
        "title": "DatasetProfileOut",
        "description": "Schema, sample rows and statistics (see pipeline/profile.py); null until ready."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "InstitutionKeywordParams": {
        "properties": {
          "max_authors": {
            "type": "integer",
            "maximum": 200.0,
            "minimum": 2.0,
            "title": "Max Authors",
            "description": "Drop articles with more authors",
            "default": 15
          },
          "max_team_categories": {
            "type": "integer",
            "maximum": 50.0,
            "minimum": 1.0,
            "title": "Max Team Categories",
            "default": 12
          },
          "min_team_size": {
            "type": "integer",
            "maximum": 1000.0,
            "minimum": 1.0,
            "title": "Min Team Size",
            "default": 2
          },
          "group_column": {
            "type": "string",
            "enum": [
              "institution_department",
              "institution",
              "country"
            ],
            "title": "Group Column",
            "default": "institution_department"
          },
          "max_keyword_df": {
            "type": "number",
            "maximum": 1.0,
            "exclusiveMinimum": 0.0,
            "title": "Max Keyword Df",
            "description": "Ignore keywords in more than this share of articles",
            "default": 0.12
          },
          "min_shared_keywords": {
            "type": "integer",
            "maximum": 50.0,
            "minimum": 1.0,
            "title": "Min Shared Keywords",
            "default": 3
          },
          "top_n": {
            "type": "integer",
            "maximum": 2000.0,
            "minimum": 10.0,
            "title": "Top N",
            "default": 150
          },
          "team_attribute": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "country",
                  "institution"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Team Attribute",
            "default": "country"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "InstitutionKeywordParams"
      },
      "InstitutionKeywordRunCreate": {
        "properties": {
          "dataset_id": {
            "type": "integer",
            "title": "Dataset Id"
          },
          "relation": {
            "type": "string",
            "const": "institution_keywords",
            "title": "Relation"
          },
          "params": {
            "$ref": "#/components/schemas/InstitutionKeywordParams",
            "default": {
              "max_authors": 15,
              "max_team_categories": 12,
              "min_team_size": 2,
              "group_column": "institution_department",
              "max_keyword_df": 0.12,
              "min_shared_keywords": 3,
              "top_n": 150,
              "team_attribute": "country"
            }
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "dataset_id",
          "relation"
        ],
        "title": "InstitutionKeywordRunCreate"
      },
      "Network": {
        "properties": {
          "nodes": {
            "items": {
              "$ref": "#/components/schemas/NetworkNode"
            },
            "type": "array",
            "title": "Nodes"
          },
          "edges": {
            "items": {
              "$ref": "#/components/schemas/NetworkEdge"
            },
            "type": "array",
            "title": "Edges"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "nodes",
          "edges"
        ],
        "title": "Network"
      },
      "NetworkEdge": {
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1,
            "title": "Source"
          },
          "target": {
            "type": "string",
            "minLength": 1,
            "title": "Target"
          },
          "type": {
            "type": "string",
            "minLength": 1,
            "title": "Type",
            "description": "Relationship, e.g. collaborates_with, shares_keywords_with. Drives the Relationship filter."
          },
          "weight": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Weight",
            "description": "Strength, e.g. number of shared articles."
          },
          "attr": {
            "anyOf": [
              {
                "additionalProperties": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "integer"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "items": {
                        "type": "string"
                      },
                      "type": "array"
                    }
                  ]
                },
                "type": "object",
                "description": "Display/search-only attributes. Never drives color or the Group/Relationship filters. Empty values are omitted."
              },
              {
                "type": "null"
              }
            ],
            "title": "Attr"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "source",
