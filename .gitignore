# Raw WoS exports (licensed source data) - kept locally, not in git
data/
legacy/WoS

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# Node
node_modules/
frontend/dist/

# Env / secrets
.env
.env.*
!.env.example

# Editors / OS
.vscode/
.idea/
.DS_Store

# Jupyter
.ipynb_checkpoints/

# Local runtime data (uploads, logs)
backend/var/

# Deployment
deploy/backups/
# Playwright
frontend/test-results/
frontend/playwright-report/

# Terraform: state and personal values stay local (.terraform.lock.hcl IS committed)
infra/**/.terraform/
infra/**/*.tfstate
infra/**/*.tfstate.*
infra/**/terraform.tfvars
infra/**/crash.log
# Server backups saved by infra/server.sh (password hashes, user data)
infra/envs/*/backups/

# Claude Code personal settings (machine-specific)
.claude/settings.local.json
