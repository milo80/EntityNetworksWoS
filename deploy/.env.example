# Copy to deploy/.env (git-ignored) and edit. Read by compose.yaml.

# Public domain (Caddy gets a Let's Encrypt certificate for it), or
# "localhost" for a local run with Caddy's own local certificate.
SITE_ADDRESS=localhost

# Database password: letters and digits only (it goes into a URL), e.g.
#   openssl rand -hex 24
POSTGRES_PASSWORD=change-me

# Production: false, and create accounts with
#   docker compose exec api python -m app.manage create-user you@example.org --admin
# Local/CI runs may set it to true (the smoke test registers its own account).
ALLOW_REGISTRATION=false

# Address users open the app at; password reset emails link here. Defaults to
# https://<SITE_ADDRESS>. Set it when the port isn't 443, e.g. for a local run:
#   PUBLIC_BASE_URL=https://localhost:8443
#PUBLIC_BASE_URL=

# Outgoing email for password reset links (SMTP with STARTTLS).
# Leave SMTP_HOST empty to send nothing: the reset link is then written to the
# API log (docker compose logs api), which is fine locally and in CI.
# Gmail: use a separate account made only for sending (not your personal one),
# turn on 2-Step Verification, create an app password (Google Account ->
# Security -> App passwords) and put that 16-character code here, never the
# account password. Revoking the app password cuts the app off.
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USERNAME=yourapp.noreply@gmail.com
#   SMTP_PASSWORD=abcdefghijklmnop
#   SMTP_FROM=EntityNetworks <yourapp.noreply@gmail.com>
SMTP_HOST=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Host ports. Rootless podman can't bind ports below 1024: use e.g. 8080/8443.
HTTP_PORT=80
HTTPS_PORT=443

# Image tag (CI/deploy set this to the git commit).
TAG=local
# Where the images come from. Empty: built locally by `compose up --build`.
# Servers (infra/server.sh): the images CI tested, e.g. ghcr.io/milo80/
#IMAGE_PREFIX=
# Off-server copy of each backup (deploy/backup.sh). Not used by Compose.
# PROD: set by infra/server.sh from Terraform's backup_bucket output.
#BACKUP_S3_URI=s3://entitynetworks-prod-backups-123456789012/
LOG_LEVEL=INFO
