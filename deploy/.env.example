# Copy to deploy/.env (git-ignored) and edit. Read by compose.yaml.

# Public domain (Caddy gets a Let's Encrypt certificate for it), or
# "localhost" for a local run with Caddy's own local certificate.
SITE_ADDRESS=localhost

# Database password: letters and digits only (it goes into a URL), e.g.
#   openssl rand -hex 24
POSTGRES_PASSWORD=change-me

# Production: false, and create accounts with
#   docker compose exec api python -m app.manage create-user you@example.org --admin
# Local/CI runs may set it to true (the smoke test registers its own account).
ALLOW_REGISTRATION=false

# Host ports. Rootless podman can't bind ports below 1024: use e.g. 8080/8443.
HTTP_PORT=80
HTTPS_PORT=443

# Image tag (CI/deploy set this to the git commit).
TAG=local
LOG_LEVEL=INFO
