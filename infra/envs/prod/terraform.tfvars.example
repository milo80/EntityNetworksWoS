# Copy to terraform.tfvars (git-ignored) and fill in.

# AWS region for this environment, e.g. eu-central-1 or us-east-1.
region = "eu-central-1"

# Contents of your SSH public key file (e.g. ~/.ssh/id_ed25519.pub), one line.
ssh_public_key = "ssh-ed25519 AAAA... you@laptop"

# Your public IP with /32 (see https://checkip.amazonaws.com). Add more as needed.
ssh_allowed_cidrs = ["203.0.113.7/32"]
