# Copy to backend/.env (read by app.config.Settings) and adjust. Never commit .env.
# Every variable is optional; the defaults below are the development defaults.

APP_ENV=development            # development | test | production
LOG_LEVEL=INFO

DATABASE_URL=postgresql+psycopg://entitynet:entitynet@localhost:5432/entitynet
UPLOAD_DIR=var/uploads         # relative to backend/ when run from there

# Uploads
MAX_UPLOAD_MB=50               # per file
MAX_FILES_PER_DATASET=10

# Auth
ALLOW_REGISTRATION=true        # false: create accounts with `python -m app.manage create-user`
SESSION_TTL_HOURS=168
COOKIE_SECURE=false            # MUST be true in production (enforced); false only for plain-http dev

# Rate limits, requests per minute per client IP
LOGIN_RATE_PER_MINUTE=10
REGISTER_RATE_PER_MINUTE=5
UPLOAD_RATE_PER_MINUTE=10

# Only if the UI is served from another origin (JSON list). Same-origin needs nothing.
# ALLOWED_ORIGINS=["http://localhost:5173"]

# Worker
WORKER_POLL_SECONDS=2.0
WORKER_MAX_ATTEMPTS=3
